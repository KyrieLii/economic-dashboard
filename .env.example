# Docker/local: persistent SQLite. In Vercel, set TURSO_DATABASE_URL + TURSO_AUTH_TOKEN.
DATABASE_URL=file:data/economic.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Generate with: openssl rand -hex 32. Required for HTTP collection, never sent to the browser.
CRON_SECRET=
# Optional access password for the whole deployed dashboard (HTTP Basic username: viewer).
DASHBOARD_PASSWORD=
PORT=3001
# Docker scheduler; off for local development and always off on Vercel.
ENABLE_SCHEDULER=false
# Optional upstream HTTP(S) proxy for data providers.
DATA_PROXY_URL=
