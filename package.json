{
  "name": "economic-dashboard",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web 'tsx watch --env-file-if-exists=.env server/index.ts' 'vite --host 127.0.0.1'",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=build/server.js",
    "start": "node --env-file-if-exists=.env build/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "collect": "tsx --env-file-if-exists=.env scripts/collect.ts",
    "backup": "tsx --env-file-if-exists=.env scripts/backup.ts",
    "restore": "tsx --env-file-if-exists=.env scripts/restore.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.11",
    "@libsql/client": "^0.18.0",
    "@tanstack/react-query": "^5.108.4",
    "hono": "^4.13.22",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "undici": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
