  "narrative": {
    "northStar": "Scientific figure plates",
    "overview": "A dark observation desk with calibrated charts, aligned measurements, and quiet dividing rules. Its modern, technical character comes from precise numeric typography and readable evidence, rather than decoration.\n\nChinese interface labels use the system CJK fallback beside locally bundled Latin fonts. Dates, units, sources, and missing-data states remain part of the visual hierarchy.",
    "keyCharacteristics": [
      "Charcoal surfaces with restrained lime selection and action accents.",
      "Monospaced measurements paired with compact sans-serif labels.",
      "Flat, ruled panels and responsive detail views."
    ],
    "rules": [
      {
        "name": "The Signed Change Rule",
        "body": "Pair rise/fall color with a sign and unit; color alone never carries the meaning.",
        "section": "colors"
      },
      {
        "name": "The Measurement Rule",
        "body": "Use the mono face for quantities and identifiers; retain the sans-serif stack for descriptive labels. Auxiliary text and chart axes stay at least 12px in the implemented layouts.",
        "section": "typography"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Separate data regions with the existing tonal layers and thin rules before adding elevation.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** align quantities and use explicit units, dates, and signed changes.",
      "**Do** use lime consistently for selection, primary action, and chart emphasis.",
      "**Do** preserve visible focus and the mobile selection-to-detail behavior.",
      "**Do** show missing observations and source failures explicitly."
    ],
    "donts": [
      "**Don't** imply rise or fall through color alone.",
      "**Don't** substitute invented chart points for absent observations.",
      "**Don't** add decorative imagery or hero typography to the data workspace.",
      "**Don't** hide latest values or changes to make the mobile table fit."
    ]
  }
}
